(function($){
    $(document).ready(function(){
        $('.quizques-value-item').click(function(){
            $(this).closest('.quizques-value').find('.quizques-value-item').removeClass('active');
            $(this).addClass('active')
        })

        document.addEventListener('wpcf7submit', function (event) {
            if(event.detail.contactFormId == '5026'){
                const answers = {};
                $('.quizques-ques').each(function () {
                    const questionID = $(this).data('questionid');
                    const selectedAnswer = $(this).find('.quizques-value-item.active').data('answerid')
                    if (selectedAnswer) {
                        answers[questionID] = selectedAnswer;
                    }
                });

                if (Object.keys(answers).length !== $('.quizques-ques').length) {
                    event.preventDefault(); // Ngăn form gửi đi
                    return false;
                }
                
            }    
        });

        document.addEventListener('wpcf7mailsent', function(event) {
            if(event.detail.contactFormId == '5026'){
                const answers = {};
                $('.quizques-ques').each(function () {
                    const questionID = $(this).data('questionid');
                    const selectedAnswer = $(this).find('.quizques-value-item.active').data('answerid')
                    if (selectedAnswer) {
                        answers[questionID] = selectedAnswer;
                    }
                });

                $.ajax({
                    url: admin_ajax_url.ajaxurl, // URL của WordPress AJAX
                    method: 'POST',
                    data: {
                        action: 'match_products',
                        answers: answers,
                        user_name: $('input[name="quizname"]').val(),
                        user_email: $('input[name="quizmail"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            $('.quiz-product-result-wrapper .col-inner').html(response.data)
                            $('#quiz-result .image-zoom a').attr("target","_blank");
                            $('.quiz-result-now').trigger('click');
                        } else {
                            alert(response.data);
                        }
                    },
                    error: function () {
                        toastr.error('Có lỗi xảy ra khi gửi câu trả lời.');
                    },
                });

                

                // if (Object.keys(answers).length === $('.quizques-ques').length) {
                    
                // } else {
                //     toastr.info('Vui lòng trả lời tất cả các câu hỏi.');
                // }
            }
        }, false);

    });
})(jQuery);