Options -Indexes
DirectoryIndex index.php
RewriteEngine On
# Application code is private even when the repository root is the document root.
RewriteRule ^(?:app|bootstrap|config|database|routes|tests|docs)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
